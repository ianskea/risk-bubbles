autoload -Uz compinit
compinit

# PHP paths - using generic symlink for easy version switching
export PATH="/opt/homebrew/opt/php/bin:$PATH"
export PATH="/opt/homebrew/opt/php/sbin:$PATH"
export PATH="$HOME/.composer/vendor/bin:$PATH"
export PATH="$HOME/.config/composer/vendor/bin:$PATH"

# Enable Zsh history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# Added by Antigravity
export PATH="/Users/ianskea/.antigravity/antigravity/bin:$PATH"

# PHP version helper function
parse_php_version() {
  php -v 2>/dev/null | head -n 1 | awk '{print $2}'
}

# Aliases
alias phpv="php -v | head -n 1"
alias php83="brew unlink php php@8.4 php@8.5 && brew link --force --overwrite php@8.3"
alias php84="brew unlink php php@8.3 php@8.5 && brew link --force --overwrite php@8.4"
alias php85="brew unlink php php@8.3 php@8.4 && brew link --force --overwrite php"
